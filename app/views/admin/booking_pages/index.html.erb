<% if compat_read_enabled? %>
  <%= react_component("admin/booking_pages/index", {
    userId: @lookup_user_id,
    bookingPagePathPrefix: booking_page_path("").sub(%r{/$}, ""),
  }) %>
<% else %>
<ul>
  <% @booking_pages.each do |booking_page| %>
    <li>
      <%= l(booking_page.created_at, format: :long_date_with_wday)%>
      <%= link_to booking_page.name, booking_page_path(booking_page), target: "_blank" %>
    </li>
<% end %>
</ul>
<% end %>
