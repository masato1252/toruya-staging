<% if ENV["COMPAT_API_READ_ENABLED"] == "true" %>
  <%= react_component("admin/online_service_customer_relations/index", {
    userId: @lookup_user_id,
    socialServiceUserId: @lookup_social_service_user_id,
    salePagePathPrefix: sale_page_path("").sub(%r{/$}, ""),
  }) %>
<% else %>
<ul>
  <% @relations.each do |relation| %>
    <li>
      <%= relation.start_date_text %> ~ <%= relation.end_date_text %> : 
      <%= link_to relation.online_service.name, sale_page_path(relation.sale_page), target: "_blank" %>
      <%= relation.customer.name %>
      <%= relation.payment_state %>
      <%= Money.new(relation.product_amount, relation.sale_page.user.currency).format %>
    </li>
<% end %>
</ul>
<% end %>
