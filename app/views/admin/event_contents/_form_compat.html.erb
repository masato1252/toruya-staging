<%
  event = context.fetch("event")
  content = context.fetch("event_content")
  persisted = content["id"].present?
  related_contents = context["related_contents"] || []
  related_ids = content["related_content_ids"] || []
  documents = content["related_documents"] || []
  images = content["images"] || []
  speakers = content["speakers"] || []
  roles = context["exhibitor_roles"] || []
  event_id = event["id"]
  content_id = content["id"]
%>

<div class="admin-event-form">
  <%= form_with url: form_url, scope: :event_content, method: form_method, local: true, multipart: true do |f| %>
    <div class="admin-form-section">
      <div class="admin-form-section-title">公開ステータス</div>
      <div class="admin-form-group">
        <label class="admin-form-label">公開状態</label>
        <div class="admin-form-input">
          <%= f.select :status, [["公開", "published"], ["下書き / 非公開", "unpublished"]],
                       { selected: content["status"] || "published" }, class: "form-control", style: "max-width:240px;" %>
        </div>
      </div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">基本情報</div>
      <div class="admin-form-group">
        <label class="admin-form-label">コンテンツ種別<span class="required-mark">*</span></label>
        <div class="admin-form-input">
          <% [["seminar", "セミナー講演"], ["booth", "展示ブース(PDF)"]].each do |value, label| %>
            <label style="margin-right:18px;">
              <%= f.radio_button :content_type, value, checked: content["content_type"] == value, disabled: persisted, class: "compat-content-type" %>
              <%= label %>
            </label>
          <% end %>
          <% if persisted %>
            <%= f.hidden_field :content_type, value: content["content_type"] %>
            <span class="admin-form-help">コンテンツ作成後は種別を変更できません。</span>
          <% end %>
        </div>
      </div>
      <% [
        ["タイトル", :title, "text", true],
        ["紹介文", :introduction, "textarea", false],
        ["説明文", :description, "textarea", false]
      ].each do |label, key, kind, required| %>
        <div class="admin-form-group">
          <label class="admin-form-label"><%= label %><%= raw('<span class="required-mark">*</span>') if required %></label>
          <div class="admin-form-input">
            <% if kind == "textarea" %>
              <%= f.text_area key, value: content[key.to_s], rows: key == :description ? 5 : 3, class: "form-control" %>
            <% else %>
              <%= f.text_field key, value: content[key.to_s], required: required, class: "form-control" %>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="admin-form-group">
        <label class="admin-form-label">サムネイル画像</label>
        <div class="admin-form-input">
          <% if content["thumbnail_url"].present? %>
            <%= image_tag content["thumbnail_url"], style: "display:block;max-height:150px;max-width:100%;margin-bottom:8px;border-radius:4px;" %>
          <% end %>
          <%= f.file_field :thumbnail, accept: "image/jpeg,image/png,image/gif" %>
        </div>
      </div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">出展者業種タグ</div>
      <%= hidden_field_tag "event_content[exhibitor_roles][]", "" %>
      <div style="display:flex;flex-wrap:wrap;gap:8px;padding:16px;">
        <% roles.each do |role| %>
          <label style="padding:6px 12px;border:1px solid #d1d5db;border-radius:18px;">
            <%= check_box_tag "event_content[exhibitor_roles][]", role, Array(content["exhibitor_roles"]).include?(role) %>
            <%= role %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">開催設定</div>
      <% [["サービス開始日時", :start_at], ["サービス終了日時", :end_at]].each do |label, key| %>
        <div class="admin-form-group">
          <label class="admin-form-label"><%= label %></label>
          <div class="admin-form-input"><%= f.datetime_local_field key, value: content[key.to_s], class: "form-control" %></div>
        </div>
      <% end %>
      <div class="admin-form-group">
        <label class="admin-form-label">利用開始上限人数</label>
        <div class="admin-form-input">
          <%= f.number_field :capacity, value: content["capacity"], min: 1, class: "form-control", placeholder: "空欄で無制限" %>
          <div id="compat-acquisition-counts" style="display:none;margin-top:8px;color:#6b7280;"></div>
        </div>
      </div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">関連資料のダウンロード</div>
      <div id="compat-documents" style="padding:16px;">
        <% documents.each do |document| %>
          <div class="compat-document-row" style="display:flex;gap:8px;margin-bottom:8px;">
            <%= hidden_field_tag "event_content[related_documents][][id]", document["id"] %>
            <%= text_field_tag "event_content[related_documents][][title]", document["title"], class: "form-control", placeholder: "資料名" %>
            <%= url_field_tag "event_content[related_documents][][url]", document["url"], class: "form-control", placeholder: "https://..." %>
            <button type="button" class="compat-remove-row btn btn-gray">削除</button>
          </div>
        <% end %>
      </div>
      <div style="padding:0 16px 16px;"><button type="button" id="compat-add-document" class="btn btn-gray">＋ 関連資料を追加</button></div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">関連コンテンツ</div>
      <%= hidden_field_tag "event_content[related_content_ids][]", "" %>
      <div id="compat-related-contents" style="padding:16px;" data-options="<%= related_contents.to_json %>">
        <% related_ids.each do |related_id| %>
          <div class="compat-related-row" style="display:flex;gap:8px;margin-bottom:8px;">
            <select name="event_content[related_content_ids][]" class="form-control">
              <option value="">選択してください</option>
              <% related_contents.each do |related| %>
                <option value="<%= related["id"] %>" <%= "selected" if related["id"].to_i == related_id.to_i %>>
                  #<%= related["id"] %> <%= related["title"] %>（<%= related["content_type"] == "seminar" ? "セミナー講演" : "展示ブース" %>）
                </option>
              <% end %>
            </select>
            <button type="button" class="compat-remove-row btn btn-gray">削除</button>
          </div>
        <% end %>
      </div>
      <div style="padding:0 16px 16px;"><button type="button" id="compat-add-related" class="btn btn-gray">＋ 関連コンテンツを追加</button></div>
    </div>

    <div class="admin-form-section compat-seminar-only">
      <div class="admin-form-section-title">動画・資料設定（セミナー講演向け）</div>
      <% [
        ["動画本編URL", :video_url],
        ["広告動画URL（前）", :pre_ad_video_url],
        ["広告動画URL（後）", :post_ad_video_url],
        ["資料ダウンロードURL", :direct_download_url]
      ].each do |label, key| %>
        <div class="admin-form-group">
          <label class="admin-form-label"><%= label %></label>
          <div class="admin-form-input"><%= f.url_field key, value: content[key.to_s], class: "form-control" %></div>
        </div>
      <% end %>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">出展者との紐付け</div>
      <div class="admin-form-group">
        <label class="admin-form-label">出展店舗（ユーザID）</label>
        <div class="admin-form-input">
          <div style="display:flex;gap:8px;margin-bottom:8px;">
            <input id="compat-shop-user-id" type="number" class="form-control" style="max-width:180px;" value="<%= content["shop_user_id"] %>" placeholder="ユーザID">
            <button id="compat-shop-search" type="button" class="btn btn-gray">検索</button>
          </div>
          <select id="compat-shop-select" class="form-control">
            <option value="">選択してください</option>
            <% if content["shop_id"].present? %><option value="<%= content["shop_id"] %>" selected><%= content["shop_name"] %></option><% end %>
          </select>
          <%= f.hidden_field :shop_id, value: content["shop_id"], id: "compat-shop-id" %>
          <div id="compat-ref-links" style="margin-top:10px;<%= 'display:none;' unless content["shop_id"].present? %>">
            <input id="compat-ref-top" readonly class="form-control" data-base="<%= "#{request.base_url}/#{event["slug"]}" %>">
            <% if persisted %><input id="compat-ref-content" readonly class="form-control" style="margin-top:6px;" data-base="<%= "#{request.base_url}/#{event["slug"]}/event_contents/#{content_id}" %>"><% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-form-section compat-booth-only">
      <div class="admin-form-section-title">出展者情報・展示ブース設定</div>
      <% [["企業名", :exhibitor_company_name], ["説明", :exhibitor_description]].each do |label, key| %>
        <div class="admin-form-group">
          <label class="admin-form-label"><%= label %></label>
          <div class="admin-form-input"><%= f.text_area key, value: content[key.to_s], rows: 3, class: "form-control" %></div>
        </div>
      <% end %>
      <div class="admin-form-group">
        <label class="admin-form-label">ロゴ画像</label>
        <div class="admin-form-input">
          <% if content["exhibitor_logo_url"].present? %><%= image_tag content["exhibitor_logo_url"], style: "display:block;max-width:200px;max-height:100px;margin-bottom:8px;" %><% end %>
          <%= f.file_field :exhibitor_logo, accept: "image/*" %>
        </div>
      </div>
      <div class="admin-form-group">
        <label class="admin-form-label">オンラインサービス紐付け</label>
        <div class="admin-form-input">
          <select id="compat-service-select" class="form-control">
            <option value="">選択してください</option>
            <% if content["online_service_id"].present? %><option value="<%= content["online_service_id"] %>" selected><%= content["online_service_name"] %></option><% end %>
          </select>
          <%= f.hidden_field :online_service_id, value: content["online_service_id"], id: "compat-service-id" %>
        </div>
      </div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">アップセル設定</div>
      <div class="admin-form-group">
        <div class="admin-form-input">
          <%= f.check_box :upsell_booking_enabled, { checked: content["upsell_booking_enabled"], id: "compat-upsell-enabled" }, "1", "0" %>
          <label for="compat-upsell-enabled">無料相談予約を設定する</label>
        </div>
      </div>
      <div id="compat-upsell-details">
        <div class="admin-form-group">
          <label class="admin-form-label">予約ページ（ユーザID）</label>
          <div class="admin-form-input">
            <div style="display:flex;gap:8px;margin-bottom:8px;">
              <input id="compat-upsell-user-id" type="number" class="form-control" style="max-width:180px;" value="<%= content["upsell_booking_page_user_id"] %>" placeholder="ユーザID">
              <button id="compat-upsell-search" type="button" class="btn btn-gray">検索</button>
            </div>
            <select id="compat-upsell-shop" class="form-control">
              <option value="">店舗を選択</option>
              <% if content["upsell_booking_page_shop_id"].present? %><option value="<%= content["upsell_booking_page_shop_id"] %>" selected><%= content["upsell_booking_page_shop_name"] %></option><% end %>
            </select>
            <select id="compat-upsell-page" class="form-control" style="margin-top:8px;">
              <option value="">予約ページを選択</option>
              <% if content["upsell_booking_page_id"].present? %><option value="<%= content["upsell_booking_page_id"] %>" selected><%= content["upsell_booking_page_title"] %></option><% end %>
            </select>
            <%= f.hidden_field :upsell_booking_page_id, value: content["upsell_booking_page_id"], id: "compat-upsell-page-id" %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-form-section">
      <div class="admin-form-section-title">モニター募集設定</div>
      <div class="admin-form-group">
        <div class="admin-form-input">
          <%= f.check_box :monitor_enabled, { checked: content["monitor_enabled"], id: "compat-monitor-enabled" }, "1", "0" %>
          <label for="compat-monitor-enabled">モニター募集を設定する</label>
        </div>
      </div>
      <div id="compat-monitor-details">
        <% [["モニターサービス名", :monitor_name, "text"], ["モニター金額（円）", :monitor_price, "number"], ["モニター上限人数", :monitor_limit, "number"], ["応募フォームURL", :monitor_form_url, "url"]].each do |label, key, type| %>
          <div class="admin-form-group">
            <label class="admin-form-label"><%= label %></label>
            <div class="admin-form-input"><%= f.send("#{type}_field", key, value: content[key.to_s], class: "form-control") %></div>
          </div>
        <% end %>
      </div>
    </div>

    <% if persisted %>
      <div class="admin-form-section compat-booth-only">
        <div class="admin-form-section-title">資料プレビュー（スライド画像）</div>
        <div id="compat-images" style="display:flex;flex-wrap:wrap;gap:12px;padding:16px;">
          <% images.each do |image| %>
            <div class="compat-image" data-id="<%= image["id"] %>">
              <%= image_tag image["url"], style: "width:120px;height:80px;object-fit:cover;border-radius:4px;" %>
              <div><button type="button" class="compat-move-left">←</button><button type="button" class="compat-move-right">→</button><button type="button" class="compat-delete-image" data-url="<%= destroy_image_admin_event_content_path(content_id, image_id: image["id"]) %>">削除</button></div>
            </div>
          <% end %>
        </div>
        <div style="padding:0 16px 16px;"><input id="compat-image-upload" type="file" accept="image/*"></div>
      </div>

      <div class="admin-form-section compat-seminar-only">
        <div class="admin-form-section-title">出演者</div>
        <div id="compat-speakers" style="padding:16px;">
          <% speakers.each do |speaker| %>
            <div class="compat-speaker" data-id="<%= speaker["id"] %>" data-update-url="<%= update_speaker_admin_event_content_path(content_id, speaker_id: speaker["id"]) %>" style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
              <% if speaker["profile_image_url"].present? %><%= image_tag speaker["profile_image_url"], style: "width:48px;height:48px;border-radius:50%;object-fit:cover;" %><% end %>
              <span><strong><%= speaker["name"] %></strong><br><%= speaker["position_title"] %></span>
              <button type="button" class="compat-edit-speaker btn btn-gray" data-name="<%= speaker["name"] %>" data-position="<%= speaker["position_title"] %>" data-introduction="<%= speaker["introduction"] %>">編集</button>
              <button type="button" class="compat-delete-speaker btn btn-gray" data-url="<%= destroy_speaker_admin_event_content_path(content_id, speaker_id: speaker["id"]) %>">削除</button>
              <button type="button" class="compat-move-up">↑</button><button type="button" class="compat-move-down">↓</button>
            </div>
          <% end %>
        </div>
        <div style="padding:0 16px 16px;"><button type="button" id="compat-add-speaker" class="btn btn-gray">＋ 出演者を追加</button></div>
      </div>

      <div id="compat-speaker-modal" role="dialog" aria-modal="true" aria-labelledby="compat-speaker-modal-title" style="display:none;position:fixed;inset:0;z-index:9999;">
        <div id="compat-speaker-modal-overlay" style="position:absolute;inset:0;background:rgba(0,0,0,0.5);"></div>
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:480px;max-width:calc(100vw - 32px);max-height:calc(100vh - 64px);overflow-y:auto;background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.3);padding:24px;">
          <h3 id="compat-speaker-modal-title" style="margin:0 0 20px;font-size:16px;">出演者を追加</h3>
          <div style="margin-bottom:16px;">
            <label for="compat-speaker-image" style="display:block;font-weight:600;margin-bottom:6px;">プロフィール画像</label>
            <div id="compat-speaker-image-preview" style="margin-bottom:8px;"></div>
            <input id="compat-speaker-image" type="file" accept="image/jpeg,image/png,image/gif">
          </div>
          <div style="margin-bottom:16px;">
            <label for="compat-speaker-name" style="display:block;font-weight:600;margin-bottom:6px;">名前 <span class="required-mark">*</span></label>
            <input id="compat-speaker-name" type="text" class="form-control" required>
            <div id="compat-speaker-name-error" class="admin-form-error" style="display:none;">名前を入力してください</div>
          </div>
          <div style="margin-bottom:16px;">
            <label for="compat-speaker-position" style="display:block;font-weight:600;margin-bottom:6px;">肩書き</label>
            <input id="compat-speaker-position" type="text" class="form-control">
          </div>
          <div style="margin-bottom:20px;">
            <label for="compat-speaker-introduction" style="display:block;font-weight:600;margin-bottom:6px;">紹介文</label>
            <textarea id="compat-speaker-introduction" rows="4" class="form-control"></textarea>
          </div>
          <div id="compat-speaker-save-error" class="admin-form-error" style="display:none;margin-bottom:12px;">出演者を保存できませんでした</div>
          <div style="display:flex;justify-content:flex-end;gap:8px;">
            <button type="button" id="compat-speaker-cancel" class="btn btn-gray">キャンセル</button>
            <button type="button" id="compat-speaker-save" class="btn btn-tarco">保存</button>
          </div>
        </div>
      </div>
    <% end %>

    <div class="admin-form-actions">
      <% if persisted %><%= link_to "削除", admin_event_content_path(content_id), method: :delete, data: { confirm: "このコンテンツを削除しますか？" }, class: "btn btn-danger", style: "margin-right:auto;" %><% end %>
      <%= link_to "キャンセル", admin_event_path(event_id), class: "btn btn-gray" %>
      <%= f.submit persisted ? "更新" : "作成", class: "btn btn-tarco" %>
    </div>
  <% end %>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
  const byId = id => document.getElementById(id);
  const jsonFetch = (url, options) => fetch(url, options).then(r => {
    if (!r.ok) throw new Error("request failed");
    return r.status === 204 ? {} : r.json();
  });
  const shopsUrl = "<%= shops_by_user_admin_event_event_contents_path(event_id) %>";
  const servicesUrl = "<%= online_services_for_shop_admin_event_event_contents_path(event_id) %>";
  const pagesUrl = "<%= booking_pages_for_shop_admin_event_event_contents_path(event_id) %>";
  const countsUrl = "<%= shop_acquisition_counts_admin_event_event_contents_path(event_id) %>";

  function toggleSections() {
    const seminar = document.querySelector('input[name="event_content[content_type]"]:checked')?.value === "seminar";
    document.querySelectorAll(".compat-seminar-only").forEach(el => el.style.display = seminar ? "" : "none");
    document.querySelectorAll(".compat-booth-only").forEach(el => el.style.display = seminar ? "none" : "");
  }
  document.querySelectorAll(".compat-content-type").forEach(el => el.addEventListener("change", toggleSections));
  toggleSections();

  function toggleDetails(boxId, detailsId) {
    const box = byId(boxId), details = byId(detailsId);
    if (!box || !details) return;
    const update = () => details.style.display = box.checked ? "" : "none";
    box.addEventListener("change", update); update();
  }
  toggleDetails("compat-upsell-enabled", "compat-upsell-details");
  toggleDetails("compat-monitor-enabled", "compat-monitor-details");

  document.addEventListener("click", function(e) {
    const remove = e.target.closest(".compat-remove-row");
    if (remove) remove.closest(".compat-document-row, .compat-related-row")?.remove();
  });
  byId("compat-add-document")?.addEventListener("click", function() {
    byId("compat-documents").insertAdjacentHTML("beforeend", '<div class="compat-document-row" style="display:flex;gap:8px;margin-bottom:8px;"><input class="form-control" name="event_content[related_documents][][title]" placeholder="資料名"><input class="form-control" type="url" name="event_content[related_documents][][url]" placeholder="https://..."><button type="button" class="compat-remove-row btn btn-gray">削除</button></div>');
  });
  byId("compat-add-related")?.addEventListener("click", function() {
    const container = byId("compat-related-contents");
    const options = JSON.parse(container.dataset.options || "[]");
    const labels = options.map(item => `<option value="${item.id}">#${item.id} ${item.title}（${item.content_type === "seminar" ? "セミナー講演" : "展示ブース"}）</option>`).join("");
    container.insertAdjacentHTML("beforeend", `<div class="compat-related-row" style="display:flex;gap:8px;margin-bottom:8px;"><select class="form-control" name="event_content[related_content_ids][]"><option value="">選択してください</option>${labels}</select><button type="button" class="compat-remove-row btn btn-gray">削除</button></div>`);
  });

  function fillSelect(select, rows, label) {
    select.innerHTML = '<option value="">選択してください</option>' + rows.map(row => `<option value="${row.id}">${row[label] || row.name || row.title || ("#" + row.id)}</option>`).join("");
  }
  function updateRefLinks() {
    const shopId = byId("compat-shop-id").value;
    byId("compat-ref-links").style.display = shopId ? "" : "none";
    ["compat-ref-top", "compat-ref-content"].forEach(id => {
      const input = byId(id);
      if (input) input.value = shopId ? input.dataset.base + "?rs=" + shopId : "";
    });
  }
  function updateCounts() {
    const shopId = byId("compat-shop-id").value, target = byId("compat-acquisition-counts");
    if (!shopId) { target.style.display = "none"; return; }
    jsonFetch(countsUrl + "?shop_id=" + encodeURIComponent(shopId)).then(counts => {
      target.textContent = `紐付け先出展店舗の集客数：${counts.total || 0}（直接 ${counts.direct || 0} / 間接 ${counts.indirect || 0}）`;
      target.style.display = "";
    }).catch(() => {});
  }
  byId("compat-shop-search")?.addEventListener("click", function() {
    const userId = byId("compat-shop-user-id").value;
    if (!userId) return;
    jsonFetch(shopsUrl + "?user_id=" + encodeURIComponent(userId)).then(rows => fillSelect(byId("compat-shop-select"), rows, "name"));
  });
  byId("compat-shop-select")?.addEventListener("change", function() {
    byId("compat-shop-id").value = this.value;
    byId("compat-service-id").value = "";
    if (this.value) jsonFetch(servicesUrl + "?shop_id=" + encodeURIComponent(this.value)).then(rows => fillSelect(byId("compat-service-select"), rows, "title"));
    else fillSelect(byId("compat-service-select"), [], "title");
    updateRefLinks(); updateCounts();
  });
  byId("compat-service-select")?.addEventListener("change", function() { byId("compat-service-id").value = this.value; });
  updateRefLinks(); updateCounts();

  byId("compat-upsell-search")?.addEventListener("click", function() {
    const userId = byId("compat-upsell-user-id").value;
    if (!userId) return;
    jsonFetch(shopsUrl + "?user_id=" + encodeURIComponent(userId)).then(rows => fillSelect(byId("compat-upsell-shop"), rows, "name"));
  });
  byId("compat-upsell-shop")?.addEventListener("change", function() {
    byId("compat-upsell-page-id").value = "";
    if (this.value) jsonFetch(pagesUrl + "?shop_id=" + encodeURIComponent(this.value)).then(rows => fillSelect(byId("compat-upsell-page"), rows, "title"));
  });
  byId("compat-upsell-page")?.addEventListener("change", function() { byId("compat-upsell-page-id").value = this.value; });

  <% if persisted %>
    const request = (url, method, body) => fetch(url, { method, headers: { "X-CSRF-Token": csrf }, body }).then(r => {
      if (!r.ok) throw new Error("request failed");
      location.reload();
    });
    byId("compat-image-upload")?.addEventListener("change", function() {
      if (!this.files[0]) return;
      const body = new FormData(); body.append("image", this.files[0]);
      request("<%= upload_image_admin_event_content_path(content_id) %>", "POST", body);
    });
    byId("compat-images")?.addEventListener("click", function(e) {
      const item = e.target.closest(".compat-image");
      if (!item) return;
      if (e.target.closest(".compat-delete-image")) {
        if (confirm("この画像を削除しますか？")) request(e.target.dataset.url, "DELETE");
        return;
      }
      if (e.target.closest(".compat-move-left") && item.previousElementSibling) item.parentNode.insertBefore(item, item.previousElementSibling);
      if (e.target.closest(".compat-move-right") && item.nextElementSibling) item.parentNode.insertBefore(item.nextElementSibling, item);
      const ids = Array.from(this.querySelectorAll(".compat-image")).map(el => Number(el.dataset.id));
      jsonFetch("<%= sort_images_admin_event_content_path(content_id) %>", { method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf }, body: JSON.stringify({ ids }) }).catch(() => {});
    });
    const speakerModal = byId("compat-speaker-modal");
    const speakerModalTitle = byId("compat-speaker-modal-title");
    const speakerName = byId("compat-speaker-name");
    const speakerPosition = byId("compat-speaker-position");
    const speakerIntroduction = byId("compat-speaker-introduction");
    const speakerImage = byId("compat-speaker-image");
    const speakerImagePreview = byId("compat-speaker-image-preview");
    const speakerNameError = byId("compat-speaker-name-error");
    const speakerSaveError = byId("compat-speaker-save-error");
    const speakerSave = byId("compat-speaker-save");
    let speakerSaveUrl = null;
    let speakerSaveMethod = "POST";

    function closeSpeakerModal() {
      speakerModal.style.display = "none";
    }
    function openSpeakerModal(options) {
      speakerModalTitle.textContent = options.title;
      speakerName.value = options.name || "";
      speakerPosition.value = options.position || "";
      speakerIntroduction.value = options.introduction || "";
      speakerImage.value = "";
      speakerImagePreview.innerHTML = options.imageHtml || "";
      speakerNameError.style.display = "none";
      speakerSaveError.style.display = "none";
      speakerSave.disabled = false;
      speakerSave.textContent = "保存";
      speakerSaveUrl = options.url;
      speakerSaveMethod = options.method;
      speakerModal.style.display = "";
      speakerName.focus();
    }
    function speakerFormData() {
      const name = speakerName.value.trim();
      if (!name) {
        speakerNameError.style.display = "";
        speakerName.focus();
        return null;
      }
      const body = new FormData();
      body.append("name", name);
      body.append("position_title", speakerPosition.value.trim());
      body.append("introduction", speakerIntroduction.value);
      if (speakerImage.files[0]) body.append("profile_image", speakerImage.files[0]);
      return body;
    }
    byId("compat-add-speaker")?.addEventListener("click", function() {
      openSpeakerModal({
        title: "出演者を追加",
        url: "<%= add_speaker_admin_event_content_path(content_id) %>",
        method: "POST"
      });
    });
    byId("compat-speaker-cancel")?.addEventListener("click", closeSpeakerModal);
    byId("compat-speaker-modal-overlay")?.addEventListener("click", closeSpeakerModal);
    speakerName?.addEventListener("input", function() { speakerNameError.style.display = "none"; });
    speakerImage?.addEventListener("change", function() {
      const file = this.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.addEventListener("load", function() {
        speakerImagePreview.innerHTML = '<img alt="プロフィール画像プレビュー" style="width:64px;height:64px;border-radius:50%;object-fit:cover;">';
        speakerImagePreview.querySelector("img").src = reader.result;
      });
      reader.readAsDataURL(file);
    });
    speakerSave?.addEventListener("click", function() {
      const body = speakerFormData();
      if (!body) return;
      this.disabled = true;
      this.textContent = "保存中...";
      fetch(speakerSaveUrl, {
        method: speakerSaveMethod,
        headers: { "X-CSRF-Token": csrf },
        body
      }).then(response => {
        if (!response.ok) throw new Error("request failed");
        location.reload();
      }).catch(() => {
        speakerSaveError.style.display = "";
        this.disabled = false;
        this.textContent = "保存";
      });
    });
    byId("compat-speakers")?.addEventListener("click", function(e) {
      const item = e.target.closest(".compat-speaker");
      if (!item) return;
      const edit = e.target.closest(".compat-edit-speaker");
      if (edit) {
        openSpeakerModal({
          title: "出演者を編集",
          url: item.dataset.updateUrl,
          method: "PUT",
          name: edit.dataset.name,
          position: edit.dataset.position,
          introduction: edit.dataset.introduction,
          imageHtml: item.querySelector("img")?.outerHTML || ""
        });
        return;
      }
      const del = e.target.closest(".compat-delete-speaker");
      if (del) { if (confirm("この出演者を削除しますか？")) request(del.dataset.url, "DELETE"); return; }
      if (e.target.closest(".compat-move-up") && item.previousElementSibling) item.parentNode.insertBefore(item, item.previousElementSibling);
      if (e.target.closest(".compat-move-down") && item.nextElementSibling) item.parentNode.insertBefore(item.nextElementSibling, item);
      const ids = Array.from(this.querySelectorAll(".compat-speaker")).map(el => Number(el.dataset.id));
      jsonFetch("<%= sort_speakers_admin_event_content_path(content_id) %>", { method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf }, body: JSON.stringify({ ids }) }).catch(() => {});
    });
  <% end %>
});
</script>
