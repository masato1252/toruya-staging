<%= content_for :meta_tags do %>
  <meta property="og:title" content="<%= @compat_event["title"] %>" />
  <meta property="og:description" content="<%= @compat_event["description"].to_s.truncate(120) %>" />
<% end %>

<%= react_component("events/show_bootstrap", {
  eventSlug: @compat_event["slug"],
  lineLoginUrl: @current_event_line_user_id ? nil : event_auth_line_path(event_slug: @compat_event["slug"]),
  addFriendUrl: Rails.application.secrets.dig(:ja, :toruya_official_line_add_friend_url),
  currentEventPath: request.url,
  currentEventLineUserId: @current_event_line_user_id,
}) %>
