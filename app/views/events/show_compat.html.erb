<%= content_for :meta_tags do %>
  <meta property="og:title" content="<%= @event.title %>" />
  <meta property="og:description" content="<%= @event.description&.truncate(120) %>" />
<% end %>

<%= react_component("events/show_bootstrap", {
  eventSlug: @event.slug,
  lineLoginUrl: @current_event_line_user ? nil : event_auth_line_path(event_slug: @event.slug),
  addFriendUrl: Rails.application.secrets.dig(:ja, :toruya_official_line_add_friend_url),
  currentEventPath: request.url,
  currentEventLineUserId: @current_event_line_user&.id,
}) %>
