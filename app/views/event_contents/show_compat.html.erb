<%= content_for :title do %>
  <title><%= @event_content.title %> | <%= @event.title %></title>
<% end %>

<%= content_for :meta_tags do %>
  <meta property="og:site_name" content="Toruya">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= @event_content.title %>">
  <meta property="og:url" content="<%= event_event_content_url(event_slug: @event.slug, id: @event_content.id) %>">
  <meta property="og:description" content="<%= @event_content.description&.squish&.truncate(120) || @event.description&.squish&.truncate(120) %>">
  <% if @event_content.thumbnail.attached? %>
    <meta property="og:image" content="<%= rails_blob_url(@event_content.thumbnail) %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= rails_blob_url(@event_content.thumbnail) %>">
  <% end %>
<% end %>

<%= react_component("event_contents/show_bootstrap", {
  eventSlug: @event.slug,
  contentId: @event_content.id,
  startUsageUrl: start_usage_event_event_content_path(event_slug: @event.slug, id: @event_content.id, format: "json"),
  upsellConsultationUrl: upsell_consultation_event_event_content_path(event_slug: @event.slug, id: @event_content.id, format: "json"),
  monitorApplyUrl: monitor_apply_event_event_content_path(event_slug: @event.slug, id: @event_content.id, format: "json"),
  trackActivityUrl: track_activity_event_event_content_path(event_slug: @event.slug, id: @event_content.id, format: "json"),
  backUrl: event_path(slug: @event.slug),
  lineLoginUrl: @current_event_line_user ? nil : event_auth_line_path(event_slug: @event.slug, return_to: request.path),
  participationUrl: new_event_participation_path(event_slug: @event.slug),
  captureRegistrationSourceUrl: capture_registration_source_event_event_content_path(event_slug: @event.slug, id: @event_content.id, format: "json"),
  addFriendUrl: Rails.application.secrets.dig(:ja, :toruya_official_line_add_friend_url),
  currentEventLineUserId: @current_event_line_user&.id,
}) %>
