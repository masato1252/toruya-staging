<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_sales_path(business_owner_id: business_owner_id),
          title: I18n.t("user_bot.dashboards.sales.edit.sale_pages") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/sales/#{params[:id]}/page_context",
          showQrForUrl: true,
          groupLabels: {
            sales_about: I18n.t("user_bot.dashboards.sales.edit.sales_about"),
            selling_solutions: I18n.t("user_bot.dashboards.sales.edit.selling_solutions"),
            page_content: I18n.t("user_bot.dashboards.sales.edit.page_content"),
          },
          rowLabels: {
            internal_name: I18n.t("user_bot.dashboards.sales.edit.internal_name"),
            selling_product: I18n.t("user_bot.dashboards.sales.edit.selling_product"),
            selling_start_at: I18n.t("user_bot.dashboards.sales.edit.selling_start_at"),
            selling_end_at: I18n.t("user_bot.dashboards.sales.edit.selling_end_at"),
            selling_price: I18n.t("user_bot.dashboards.sales.edit.selling_price"),
            normal_price: I18n.t("user_bot.dashboards.sales.edit.normal_price"),
            selling_number: I18n.t("user_bot.dashboards.sales.edit.selling_number"),
            content_header: I18n.t("user_bot.dashboards.sales.edit.content_header"),
            content_video: I18n.t("user_bot.dashboards.sales.edit.content_video"),
            why_content: I18n.t("user_bot.dashboards.sales.edit.why_content"),
            benefits: I18n.t("user_bot.dashboards.sales.edit.benefits"),
            staff: I18n.t("user_bot.dashboards.sales.edit.staff"),
            reviews: I18n.t("user_bot.dashboards.sales.edit.reviews"),
            faq: I18n.t("user_bot.dashboards.sales.edit.faq"),
            flow: I18n.t("user_bot.dashboards.sales.edit.flow"),
            publish: I18n.t("user_bot.dashboards.sales.edit.publish"),
          },
          warningLabels: {
            expired: I18n.t("settings.booking_page.form.form_errors.expired", default: "期限切れ"),
            sold_out: I18n.t("user_bot.dashboards.sales.edit.sold_out"),
          },
          actionLabels: {
            delete: I18n.t("user_bot.dashboards.sales.edit.delete_sale_page"),
            clone: I18n.t("common.copy"),
            copy_url: I18n.t("action.share"),
            open: I18n.t("action.open", default: "開く"),
            loading: I18n.t("common.processing"),
            confirm_delete: I18n.t("common.are_you_sure"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view">
      <%= react_component("user_bot/shared/compat_owner_show_preview", {
        pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/sales/#{params[:id]}/page_context",
        supportFeatureFlags: support_feature_flags,
        mobilePreviewLabel: I18n.t("user_bot.dashboards.sales.edit.mobile_preview", default: "モバイルプレビュー"),
        shareButtonText: I18n.t("action.share"),
      }, { camelize_props: false }) %>
    </div>
  </div>
</div>
