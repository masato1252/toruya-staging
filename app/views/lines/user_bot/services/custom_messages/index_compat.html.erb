<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="booking-page-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_service_path(params[:service_id], business_owner_id: business_owner_id),
          title: t("user_bot.dashboards.settings.custom_message.auto_message_service_label") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:service_id]}/custom_messages/page_context",
          groupLabels: {
            custom_message_scenarios: I18n.t("user_bot.dashboards.settings.custom_message.send_message_label"),
          },
          rowLabels: {
            online_service_purchased: I18n.t("user_bot.dashboards.settings.custom_message.online_service.online_service_purchased"),
          },
          actionLabels: {
            loading: I18n.t("common.processing"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
  </div>
</div>
