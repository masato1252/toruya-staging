<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_services_path(business_owner_id: business_owner_id),
          title: I18n.t("user_bot.dashboards.services.service_page") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:id]}/page_context",
          groupLabels: {
            service_about: I18n.t("user_bot.dashboards.services.service_about"),
            service_content: I18n.t("user_bot.dashboards.services.content"),
          },
          rowLabels: {
            name: I18n.t("user_bot.dashboards.services.name"),
            internal_name: I18n.t("user_bot.dashboards.services.internal_name"),
            sale_pages: I18n.t("user_bot.dashboards.sales.edit.sale_pages"),
            chapters: t("user_bot.dashboards.settings.course.chapters.title"),
            content_url: I18n.t("user_bot.dashboards.services.provided_content"),
            note: I18n.t("user_bot.dashboards.services.form.note_title"),
            external_purchase_url: I18n.t("user_bot.dashboards.services.form.external_purchase_url_title"),
            registers_count: I18n.t("user_bot.dashboards.services.registers"),
            broadcasts: I18n.t("user_bot.dashboards.broadcasts.title", default: "配信"),
            start_at: I18n.t("user_bot.dashboards.services.start_at"),
            end_at: I18n.t("user_bot.dashboards.services.end_at"),
            upsell_sale_page: I18n.t("user_bot.dashboards.services.form.upsell_sale_page_title"),
            bundled_services: I18n.t("user_bot.dashboards.services.form.bundled_services_title"),
            message_template: I18n.t("user_bot.dashboards.services.form.message_template_title"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view">
      <%= react_component("user_bot/shared/compat_owner_show_preview", {
        pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:id]}/page_context",
        supportFeatureFlags: support_feature_flags,
      }, { camelize_props: false }) %>
    </div>
  </div>
</div>
