<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_services_path(business_owner_id: business_owner_id),
          title: I18n.t("user_bot.dashboards.services.service_page") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:id]}/page_context",
          groupLabels: {
            service_about: I18n.t("user_bot.dashboards.services.service_about"),
            chapters: t("user_bot.dashboards.settings.course.chapters.title"),
            card_image: I18n.t("user_bot.dashboards.services.card_image"),
            service_content: I18n.t("user_bot.dashboards.services.content"),
            available_period: I18n.t("user_bot.dashboards.services.available_period"),
            customer_address: I18n.t("user_bot.dashboards.services.form.customer_address_required"),
            custom_messages: t("user_bot.dashboards.settings.custom_message.line_message_title"),
            broadcasts: t("sidebar.broadcast.title"),
            registers: t("user_bot.dashboards.settings.service_customer_relation.service_register"),
          },
          rowLabels: {
            name: I18n.t("user_bot.dashboards.services.name"),
            internal_name: I18n.t("user_bot.dashboards.services.internal_name"),
            sale_pages: I18n.t("user_bot.dashboards.sales.edit.sale_pages"),
            chapters: t("user_bot.dashboards.settings.course.chapters.title"),
            content_url: I18n.t("user_bot.dashboards.services.provided_content"),
            note: I18n.t("user_bot.dashboards.services.form.note_title"),
            external_purchase_url: I18n.t("user_bot.dashboards.services.form.external_purchase_url_title"),
            upsell_sale_page: I18n.t("user_bot.dashboards.services.upsell"),
            bundled_services: I18n.t("user_bot.dashboards.services.provided_content"),
            card_image: I18n.t("user_bot.dashboards.services.card_image"),
            start_at: I18n.t("user_bot.dashboards.services.start_time"),
            end_at: I18n.t("user_bot.dashboards.services.end_time"),
            customer_address_required: I18n.t("user_bot.dashboards.services.form.customer_address_required"),
            message_template: t("user_bot.dashboards.settings.custom_message.auto_message_service_label"),
            broadcasts: t("user_bot.dashboards.services.form.broadcast_to_customers", default: "登録顧客へ一括配信"),
            registers_count: t("user_bot.dashboards.settings.service_customer_relation.register"),
          },
          warningLabels: {
            no_sale_pages: I18n.t("user_bot.dashboards.services.warning.no_sale_pages"),
            no_content: I18n.t("user_bot.dashboards.settings.course.no_content"),
          },
          actionLabels: {
            delete: I18n.t("action.delete"),
            loading: I18n.t("common.processing"),
            confirm_delete: I18n.t("common.are_you_sure"),
            updated_at_prefix: I18n.t("common.updated_date"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view">
      <%= react_component("user_bot/shared/compat_owner_show_preview", {
        pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:id]}/page_context",
        supportFeatureFlags: support_feature_flags,
        shareButtonText: I18n.t("action.share"),
      }, { camelize_props: false }) %>
    </div>
  </div>
</div>
