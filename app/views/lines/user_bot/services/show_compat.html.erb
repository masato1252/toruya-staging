<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_services_path(business_owner_id: business_owner_id),
          title: I18n.t("user_bot.dashboards.services.service_page") %>

        <%= react_component("user_bot/services/show", {
          businessOwnerId: business_owner_id,
          serviceId: params[:id],
          labels: {
            about: I18n.t("user_bot.dashboards.services.service_about"),
            name: I18n.t("user_bot.dashboards.services.name"),
            internalName: I18n.t("user_bot.dashboards.services.internal_name"),
            noSalePage: t("user_bot.dashboards.services.warning.no_sale_pages"),
            noChapters: t("user_bot.dashboards.settings.course.no_content"),
            publicUrl: I18n.t("user_bot.dashboards.services.public_url"),
          },
        }) %>
      </div>
    </div>
  </div>
</div>
