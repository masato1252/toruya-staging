<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_service_chapters_path(params[:service_id], business_owner_id: business_owner_id),
          title: I18n.t("user_bot.dashboards.settings.course.lessons.show.title") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:service_id]}/chapters/#{params[:chapter_id]}/lessons/#{params[:id]}/page_context",
          groupLabels: {
            content: I18n.t("user_bot.dashboards.settings.course.lessons.show.content_label"),
            content_url: I18n.t("user_bot.dashboards.settings.course.lessons.show.content_url_label"),
            start_time: I18n.t("user_bot.dashboards.settings.course.lessons.show.start_time_label"),
            auto_message: I18n.t("user_bot.dashboards.settings.custom_message.line_message_title"),
          },
          rowLabels: {
            name: I18n.t("user_bot.dashboards.settings.course.lessons.form.name_title"),
            chapter_id: I18n.t("user_bot.dashboards.settings.course.lessons.form.chapter_id_title"),
            content_url: I18n.t("user_bot.dashboards.settings.course.lessons.form.content_url_title"),
            note: I18n.t("user_bot.dashboards.settings.course.lessons.form.note_title"),
            start_time: I18n.t("user_bot.dashboards.settings.course.lessons.form.start_time_title"),
            custom_messages: I18n.t("user_bot.dashboards.settings.custom_message.auto_message_label"),
          },
          actionLabels: {
            delete: I18n.t("action.delete"),
            loading: I18n.t("common.processing"),
            confirm_delete: I18n.t("common.are_you_sure_message"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view">
      <%= react_component("user_bot/shared/compat_owner_show_preview", {
        pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:service_id]}/chapters/#{params[:chapter_id]}/lessons/#{params[:id]}/page_context",
      }, { camelize_props: false }) %>
    </div>
  </div>
</div>
