<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar", previous_path: lines_user_bot_service_path(business_owner_id: business_owner_id, id: params[:service_id]), title: t("user_bot.dashboards.settings.service_customer_relation.service_register") %>
        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/services/#{params[:service_id]}/customers/page_context",
          groupLabels: {
            customers: t("user_bot.dashboards.settings.service_customer_relation.register"),
          },
          rowLabels: {
            name: t("common.customer_name", default: "お客様名"),
            state: t("user_bot.dashboards.broadcasts.state"),
            registered_at: t("common.updated_date", default: "登録日"),
          },
          valueLabels: {
            state: {
              pending: t("user_bot.dashboards.settings.service_customer_relation.pending", default: "承認待ち"),
              accessible: t("user_bot.dashboards.settings.service_customer_relation.accessible", default: "利用可"),
              available: t("user_bot.dashboards.settings.service_customer_relation.available", default: "利用中"),
              inactive: t("user_bot.dashboards.settings.service_customer_relation.inactive", default: "停止"),
            },
          },
          actionLabels: {
            loading: t("common.processing"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
