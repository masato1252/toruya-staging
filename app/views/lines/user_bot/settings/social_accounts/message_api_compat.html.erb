<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="settings-dashboard form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar", previous_path: lines_user_bot_settings_path(business_owner_id: business_owner_id), title: t("user_bot.dashboards.settings.dashboard.line_message_api_label") %>
        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/settings/social_account/page_context?attribute=message_api",
          groupLabels: {
            info1: t("settings.social_account.info1_label"),
            info2: t("settings.social_account.info2_label"),
          },
          rowLabels: {
            label: t("settings.social_account.form.channel_name"),
            channel_id: t("settings.social_account.form.channel_id"),
            channel_secret: t("settings.social_account.form.channel_secret"),
            basic_id: t("settings.social_account.form.channel_basic_id"),
            channel_token: t("settings.social_account.form.channel_token"),
          },
          actionLabels: {
            loading: t("common.processing"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
