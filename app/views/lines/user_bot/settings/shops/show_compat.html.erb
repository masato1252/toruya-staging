<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="settings-dashboard form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_settings_shops_path(business_owner_id: business_owner_id),
          title: t("user_bot.dashboards.settings.shop.shop_info_label") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/settings/shops/#{params[:id]}/page_context",
          groupLabels: {
            shop_info: "",
          },
          rowLabels: {
            name: t("user_bot.dashboards.settings.shop.name_label"),
            address: t("user_bot.dashboards.settings.shop.address_label"),
            phone: t("user_bot.dashboards.settings.shop.phone_number_label"),
            email: t("user_bot.dashboards.settings.shop.email_label"),
            website: t("user_bot.dashboards.settings.shop.website_label"),
            logo: t("user_bot.dashboards.settings.shop.logo_label"),
          },
          actionLabels: {
            delete: t("action.delete"),
            loading: t("common.processing"),
          },
        }) %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
