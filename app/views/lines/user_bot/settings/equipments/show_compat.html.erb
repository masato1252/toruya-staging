<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="settings-dashboard form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_settings_shop_equipments_path(shop_id: params[:shop_id], business_owner_id: business_owner_id),
          title: t("user_bot.dashboards.settings.equipments.title") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/settings/shops/#{params[:shop_id]}/equipments/page_context?equipment_id=#{params[:id]}",
          groupLabels: {
            basic: t("user_bot.dashboards.settings.equipments.title"),
          },
          rowLabels: {
            name: t("user_bot.dashboards.settings.equipments.name"),
            quantity: t("user_bot.dashboards.settings.equipments.quantity"),
            related_menus: t("user_bot.dashboards.settings.equipments.related_menus"),
          },
          actionLabels: {
            delete: t("action.delete"),
            loading: t("common.processing"),
            confirm_delete: t("common.are_you_sure"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
