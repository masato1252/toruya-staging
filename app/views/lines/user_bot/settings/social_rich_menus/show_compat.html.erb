<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="booking-options form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar", title: t("user_bot.dashboards.metrics.title"), previous_path: lines_user_bot_settings_social_account_social_rich_menus_path(business_owner_id: business_owner_id) %>
        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/settings/social_rich_menus/#{params[:id]}/page_context",
          groupLabels: {
            metrics: I18n.t("user_bot.dashboards.metrics.title"),
          },
          rowLabels: {
            content: I18n.t("user_bot.dashboards.metrics.content"),
            clicks: I18n.t("user_bot.dashboards.metrics.click_count"),
            conversions: I18n.t("user_bot.dashboards.metrics.conversion_count"),
            revenue: I18n.t("user_bot.dashboards.metrics.revenue"),
          },
          actionLabels: {
            loading: I18n.t("common.processing"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
