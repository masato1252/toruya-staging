<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="settings-dashboard form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar", previous_path: lines_user_bot_settings_path(business_owner_id: business_owner_id), title: t("user_bot.dashboards.settings.stripe.connection_title") %>
        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/settings/stripe/page_context",
          groupLabels: {
            connection: t("user_bot.dashboards.settings.stripe.connection_title"),
          },
          actionLabels: {
            loading: t("common.processing"),
          },
        }, { camelize_props: false }) %>
        <%= render "lines/user_bot/settings/stripes/connection",
          stripe_connected: @stripe_connected,
          stripe_default_payment: @stripe_default_payment %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
