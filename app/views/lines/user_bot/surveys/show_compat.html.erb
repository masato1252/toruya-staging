<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_surveys_path(business_owner_id: business_owner_id),
          title: t("user_bot.dashboards.surveys.title", default: "Survey") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/surveys/#{params[:id]}/page_context",
          showQrForUrl: true,
          groupLabels: {
            about: t("user_bot.dashboards.surveys.about", default: "About"),
            questions: t("user_bot.dashboards.surveys.questions", default: "Questions"),
          },
          rowLabels: {
            title: t("user_bot.dashboards.surveys.title", default: "Title"),
            description: t("user_bot.dashboards.surveys.description", default: "Description"),
            active: t("user_bot.dashboards.broadcasts.state"),
            question_count: t("user_bot.dashboards.surveys.questions", default: "Questions"),
            responses: t("user_bot.dashboards.surveys.responses", default: "Responses"),
          },
          warningLabels: {
            no_questions: t("user_bot.dashboards.surveys.no_questions", default: "No questions configured"),
          },
          actionLabels: {
            delete: t("action.delete"),
            copy_url: t("action.share"),
            open: t("action.open", default: "Open"),
            loading: t("common.processing"),
            confirm_delete: t("common.are_you_sure"),
          },
        }) %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view">
      <%= react_component("user_bot/shared/compat_owner_show_preview", {
        pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/surveys/#{params[:id]}/page_context",
      }) %>
    </div>
  </div>
</div>
