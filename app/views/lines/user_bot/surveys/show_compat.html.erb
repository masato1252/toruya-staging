<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_surveys_path(business_owner_id: business_owner_id),
          title: "Survey" %>

        <%= react_component("user_bot/surveys/show", {
          businessOwnerId: business_owner_id,
          surveyId: params[:id],
          labels: {
            about: "About",
            title: "Title",
            questions: "Questions",
            status: t("user_bot.dashboards.broadcasts.state"),
            active: "Active",
            inactive: "Inactive",
            publicUrl: t("action.share"),
            edit: t("action.edit"),
            settings: t("action.settings"),
          },
        }) %>
      </div>
    </div>
  </div>
</div>
