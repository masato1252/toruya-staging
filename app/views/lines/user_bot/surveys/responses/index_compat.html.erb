<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="booking-pages form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_survey_path(business_owner_id, params[:id]),
          title: t("user_bot.dashboards.surveys.responses.title") %>

        <%= react_component("user_bot/surveys/responses/index", {
          businessOwnerId: business_owner_id,
          surveyId: params[:id],
          surveyPath: lines_user_bot_survey_path(business_owner_id, params[:id]),
          labels: { empty: t("common.no_data") },
        }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
