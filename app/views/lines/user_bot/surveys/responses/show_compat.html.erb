<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="service-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_survey_responses_path(business_owner_id, params[:id]),
          title: t("user_bot.dashboards.surveys.responses.title") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/surveys/#{params[:id]}/responses/#{params[:survey_response_id]}/page_context",
          groupLabels: {
            customer: t("common.customer_name"),
            answers: t("user_bot.dashboards.surveys.responses.title"),
          },
          rowLabels: {
            customer_name: t("common.customer_name"),
          },
          actionLabels: {
            loading: I18n.t("common.processing"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
