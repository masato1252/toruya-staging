<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="booking-pages form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_survey_path(business_owner_id, params[:id]),
          title: t("user_bot.dashboards.surveys.settings.title") %>
        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/surveys/#{params[:id]}/page_context?attribute=settings",
          groupLabels: {
            settings: t("user_bot.dashboards.surveys.settings.title"),
          },
          actionLabels: {
            loading: t("common.processing"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
