<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="booking-options form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar", title: I18n.t("user_bot.dashboards.metrics.title") %>

        <div class="field-header"><%= I18n.t("user_bot.dashboards.services.service_page") %></div>
        <% if ENV["COMPAT_API_READ_ENABLED"] == "true" %>
          <%= react_component("user_bot/metrics/online_services_index", {
            businessOwnerId: business_owner_id,
            metricsServicePathPrefix: "/lines/user_bot/owner/#{business_owner_id}/metrics/online_services",
          }) %>
        <% else %>
        <div class="booking-pages-list">
          <% @online_services.each do |service| %>
            <%= link_to lines_user_bot_metrics_online_service_path(service, business_owner_id: business_owner_id), class: "field-row with-next-arrow" do %>
              <div>
                <h3><%= service.internal_product_name %></h3>
                <div class="desc"><%= I18n.t("user_bot.dashboards.online_service_creation.goals.#{service.goal_type}.title") %></div>
              </div>
              <i class="fa fa-angle-right"></i>
            <% end %>
          <% end %>
        </div>
        <% end %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
