<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="booking-page-show form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          previous_path: lines_user_bot_booking_pages_path(business_owner_id: business_owner_id),
          title: I18n.t("user_bot.dashboards.booking_pages.index.title") %>

        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/booking_pages/#{params[:id]}/page_context",
          groupLabels: {
            basic_info: I18n.t("settings.booking_page.form.basic_info_header"),
            booking_options: I18n.t("settings.booking_page.form.booking_option_header"),
            booking_period: I18n.t("settings.booking_page.form.booking_period_header"),
            customer_settings: I18n.t("settings.booking_page.form.customer_related_settings"),
            shop_info: I18n.t("common.shop"),
          },
          rowLabels: {
            draft: I18n.t("settings.booking_page.form.privacy_status"),
            name: I18n.t("settings.booking_page.form.page_name"),
            title: I18n.t("settings.booking_page.form.title_title"),
            greeting: I18n.t("settings.booking_page.form.greeting"),
            note: I18n.t("settings.booking_page.form.note_label"),
            booking_type: I18n.t("settings.booking_page.form.booking_type_label"),
            booking_time: I18n.t("settings.booking_page.form.interval_period_header"),
            booking_available_period: I18n.t("settings.booking_page.form.booking_available_period_label"),
            customer_cancel_request: I18n.t("settings.booking_page.form.customer_cancel_request"),
            multiple_selection: I18n.t("settings.booking_page.form.multiple_selection"),
            social_account_skippable: I18n.t("settings.booking_page.form.social_account_skippable"),
            online_payment: I18n.t("settings.booking_page.form.online_payment"),
            payment_option: I18n.t("settings.booking_page.form.payment_option"),
            shop: I18n.t("common.shop"),
          },
        }) %>
      </div>
    </div>

    <div class="col-sm-6 px-0 hidden-xs preview-view">
      <%= react_component("user_bot/shared/compat_owner_show_preview", {
        pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/booking_pages/#{params[:id]}/page_context",
        supportFeatureFlags: support_feature_flags,
      }) %>
    </div>
  </div>
</div>
