<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 px-0 settings-view">
      <div class="form with-top-bar">
        <%= render "lines/user_bot/top_navigation_bar",
          title: "コンテンツ",
          back_path: lines_user_bot_event_path(params[:event_id], business_owner_id: business_owner_id) %>
        <%= react_component("user_bot/shared/compat_owner_show_shell", {
          pageContextPath: "/lines/user_bot/owner/#{business_owner_id}/event_contents/#{params[:id]}/page_context",
          groupLabels: {
            content: "コンテンツ",
          },
          actionLabels: {
            loading: t("common.processing"),
            edit: "編集",
            delete: t("action.delete"),
          },
        }, { camelize_props: false }) %>
      </div>
    </div>
    <div class="col-sm-6 px-0 hidden-xs preview-view"></div>
  </div>
</div>
