<div class="modal-dialog" role="document">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h4 class="modal-title">
        <%= t("dashboard.modal.customer.data_changed_title") %>
      </h4>
    </div>
    <div class="modal-body">
      <% if @data_change %>
        <% current = @data_change.fetch("current", {}) %>
        <% requested = @data_change.fetch("requested", {}) %>
        <% current_address = current.fetch("address_details", {}) %>
        <% requested_address = requested.fetch("address_details", {}) %>
        <% name_fields = %w[last_name first_name phonetic_last_name phonetic_first_name] %>
        <% address_fields = %w[zip_code region city street1 street2] %>
        <%= t("dashboard.modal.customer.customer_change_request_desc", customer_name: [current["last_name"], current["first_name"]].compact.join(" ")) %><br /><br />
        <div class="reservation-info-row">
          <strong><%= I18n.t("dashboard.modal.customer.current_info") %>:</strong>
          <p>
            <% name_fields.each do |field| %>
              <% next unless requested.key?(field) && !requested[field].nil? %>
              <%= Customer.human_attribute_name(field) %>: <%= current[field].presence || "No-data" %><br />
            <% end %>
            <% if requested.key?("phone_number") && !requested["phone_number"].nil? %>
              <%= Customer.human_attribute_name("phone_number") %>: <%= current["phone_number"].presence || "No-data" %><br />
            <% end %>
            <% if requested.key?("email") && !requested["email"].nil? %>
              <%= Customer.human_attribute_name("email") %>: <%= current["email"].presence || "No-data" %><br />
            <% end %>
            <% if requested_address.present? %>
              <%= Customer.human_attribute_name("address") %>: <%= address_fields.map { |field| current_address[field] }.compact.join %><br />
            <% end %>
          </p>
        </div>
        <div class="reservation-info-row">
          <strong><%= I18n.t("dashboard.modal.customer.change_request_info") %>:</strong>
          <p>
            <% name_fields.each do |field| %>
              <% next unless requested.key?(field) && !requested[field].nil? %>
              <%= Customer.human_attribute_name(field) %>: <%= requested[field] %><br />
            <% end %>
            <% if requested.key?("phone_number") && !requested["phone_number"].nil? %>
              <%= Customer.human_attribute_name("phone_number") %>: <%= requested["phone_number"] %><br />
            <% end %>
            <% if requested.key?("email") && !requested["email"].nil? %>
              <%= Customer.human_attribute_name("email") %>: <%= requested["email"] %><br />
            <% end %>
            <% if requested_address.present? %>
              <%= Customer.human_attribute_name("address") %>: <%= address_fields.map { |field| requested_address[field].presence || current_address[field] }.compact.join %><br />
            <% end %>
          </p>
        </div>
      <% else %>
      <%= t("dashboard.modal.customer.customer_change_request_desc", customer_name: @customer.name) %><br /><br />

      <div class="reservation-info-row">
        <strong><%= I18n.t("dashboard.modal.customer.current_info") %>:</strong>
        <p>
          <% @reservation_customer.customer_info.name_attributes.each do |changed_attr, value| %>
            <%= Customer.human_attribute_name(changed_attr) %>: <%= @customer.public_send(changed_attr).presence || "No-data" %><br />
          <% end %>

          <% if @reservation_customer.customer_info.phone_number %>
            <%= Customer.human_attribute_name("phone_number") %>: <%= @customer.phone_number.presence || "No-data" %><br />
          <% end %>

          <% if @reservation_customer.customer_info.email %>
            <%= Customer.human_attribute_name("email") %>: <%= @customer.email.presence || "No-data" %><br />
          <% end %>

          <% if @reservation_customer.customer_info.sorted_address_details.present? %>
            <%= Customer.human_attribute_name("address") %>: <%= @customer.display_address.presence || "No-data" %><br />
          <% end %>
        </p>
      </div>

      <div class="reservation-info-row">
        <strong><%= I18n.t("dashboard.modal.customer.change_request_info") %>:</strong>
        <p>
          <% @reservation_customer.customer_info.personal_info_attributes.each do |changed_attr, value| %>
            <%= Customer.human_attribute_name(changed_attr) %>: <%= value %><br />
          <% end %>

          <% if @reservation_customer.customer_info.sorted_address_details.present? %>
            <%= Customer.human_attribute_name("address") %>: <%= @reservation_customer.display_changed_address %><br />
          <% end %>
        </p>
      </div>
      <%= render "reservations/show_modal/booking_from", reservation_customer: @reservation_customer, reservation: @reservation %>
      <% end %>
    </div>
    <div class="modal-footer">
      <%= link_to t("action.save_changes"),
        @data_change ?
          save_changes_lines_user_bot_customers_path(@compat_owner_id, params[:reservation_customer_id]) :
          site_routing_helper.save_changes_user_customers_path(@reservation_customer),
        class: "btn btn-yellow",
        remote: true,
        method: :patch,
        data: {
          controller: "save-customer-changes",
          save_customer_changes_customer_id: @data_change ? @data_change["customer_id"] : @reservation_customer.customer_id
        }
      %>
      <%= link_to t("action.ignore"), "#", class: "btn btn-gray", data: { dismiss: "modal" } %>
    </div>
  </div>
</div>
